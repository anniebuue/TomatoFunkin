import funkin.modding.base.ScriptedMusicBeatState;
import flixel.FlxSubState;
import funkin.Paths;
import funkin.ui.MusicBeatState;
import flixel.addons.display.FlxBackdrop;
import funkin.modding.base.ScriptedFlxSpriteGroup;
import flixel.group.FlxTypedSpriteGroup;
import flixel.FlxObject;
import funkin.graphics.FunkinCamera;
import funkin.graphics.adobeanimate.FlxAtlasSprite;
import funkin.audio.FunkinSound;
import flixel.addons.transition.FlxTransitionableState;
import funkin.util.Constants;
import funkin.util.WindowUtil;
import funkin.ui.title.TitleState;
import funkin.ui.story.StoryMenuState;
import funkin.ui.options.OptionsState;
import funkin.ui.freeplay.FreeplayState;
import funkin.ui.debug.DebugMenuSubState;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import funkin.util.ReflectUtil;
import flixel.tweens.FlxTween;
import flixel.FlxCamera;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.group.FlxSpriteGroup;
import flixel.addons.display.FlxRuntimeShader;
import balphabet.BAlphabet;
import StringTools;

class CustomMainMenu extends ScriptedMusicBeatState
{
  // this holds freeplay state (if there's a one to display over menu that is)
  var freeplay:FreeplayState;

  var hasSelectedCustomStory:Bool = false;

  var checker:FlxBackdrop;
  var menuItems:FlxTypedSpriteGroup;
  var curSelected:Int = 0;
  var theBarThing:FunkinSprite;
  var theBarThing2:FunkinSprite;
  var funiPoster:FunkinSprite;
  
  var preventEsc:Bool = true;

  var storyselectOverlay:FunkinSprite;
  var storyselectHeader:FunkinSprite;
  var storyselectButtonCustom:FunkinSprite;
  var storyselectButtonVanilla:FunkinSprite;
  var storyselectLock:FlxAtlasSprite;
  var storyselectLockString:String;
  var storyselectLockText:BAlphabet;
  var isStorySelectOpen:Bool = false;
  var curSelectedStorySelect:Int = 0;
  
  var isStorySelectUnlocked:Bool = false;
  var hasUnlockAnimationPlayed:Bool = false;
  
  var isPlayingUnlockAnimation:Bool = false;
  var playingUnlockAnimationTimer:Float = 0.0;
  
  var camHUD:FlxCamera;
  var optionShit:Array<String> = ['story', 'freeplay', 'merch', 'credits', 'options'];
  var confirming:Bool = false;

  override function create()
  {
    super.create();
    camHUD = new FlxCamera();
    camHUD.bgColor = 0x00000000;

    leftWatermarkText.text = Constants.VERSION;
    leftWatermarkText.cameras = leftWatermarkText.cameras = [camHUD];

    // silly Easter egg
    rightWatermarkText.text = "Tomato Funkin' v0.1.2 (Demo 1.2)";
    rightWatermarkText.cameras = [camHUD];

    transIn = FlxTransitionableState.defaultTransIn;
    transOut = FlxTransitionableState.defaultTransOut;

    persistentUpdate = persistentDraw = true;

    FlxG.cameras.reset(new FunkinCamera('mainMenu'));
    FlxG.cameras.add(camHUD, false);

    camFollow = new FlxObject(0, 0, 1, 1);
    add(camFollow);
    FlxG.camera.follow(camFollow, null, 0.06);
    FlxG.camera.snapToTarget();

    checker = new FlxBackdrop(Paths.image('funiBg'), 0x11, 0, 0);
    checker.setGraphicSize(Std.int(checker.width * 0.74));
    checker.updateHitbox();
    checker.screenCenter(0x01);
    add(checker);

    funiPoster = new FunkinSprite(580, -120).loadTexture("menu-art-rand1");
    funiPoster.setGraphicSize(Std.int(funiPoster.width * 0.6));
    funiPoster.updateHitbox();
    funiPoster.scrollFactor.set();
    add(funiPoster);

    theBarThing = new FunkinSprite(-50, -64).loadTexture("some-sortacloth-thingsll");
    theBarThing.scrollFactor.set();
    add(theBarThing);

    theBarThing2 = new FunkinSprite(243, 542).loadTexture("some-sortacloth-thingsll");
    theBarThing2.flipY = theBarThing2.flipX = true; // double flip Wut?
    theBarThing2.scrollFactor.set();
    add(theBarThing2);

    if (freeplay == null || !freeplay.alive) FunkinSound.playMusic('freakyMenu', {overrideExisting: true, restartTrack: false});
    menuItems = new FlxTypedSpriteGroup();
    add(menuItems);

    for (i in 0...optionShit.length)
    {
      var offset:Float = 150 - (Math.max(optionShit.length, 4) - 4) * 80;
      var menuItem:FunkinSprite = new FunkinSprite(90, (i * 120) + offset);
      menuItem.frames = Paths.getSparrowAtlas('mainmenustate-buttons');
      switch (optionShit[i])
      {
        case 'story':
          menuItem.animation.addByPrefix('idle', 'capsule-story-noselect', 24);
          menuItem.animation.addByPrefix('selected', 'capsule-story0', 24);
        case 'credits':
          menuItem.animation.addByPrefix('idle', 'capsule-credits-noselect', 24);
          menuItem.animation.addByPrefix('selected', 'capsule-credits0', 24);
        case 'freeplay':
          menuItem.animation.addByPrefix('idle', 'capsule-freeplay-noselect', 24);
          menuItem.animation.addByPrefix('selected', 'capsule-freeplay0', 24);
        case 'merch':
          menuItem.animation.addByPrefix('idle', 'capsule-merch-noselect', 24);
          menuItem.animation.addByPrefix('selected', 'capsule-merch0', 24);
        case 'options':
          menuItem.animation.addByPrefix('idle', 'capsule-options-noselect', 24);
          menuItem.animation.addByPrefix('selected', 'capsule-options0', 24);
      }

      menuItem.animation.play('idle');
      menuItems.add(menuItem);
      menuItem.setGraphicSize(Std.int(menuItem.width * 0.9));

      var scr:Float = (optionShit.length - 4) * 0.135;
      if (optionShit.length < 6) scr = 0;
      menuItem.scrollFactor.set(0, scr);
      menuItem.updateHitbox();
      changeItem(0);
      if (freeplay != null && freeplay.alive)
      {
        // open freeplay over MainMenu
        trace("Is Sticker: " + (freeplay.stickerSubState != null));
        openSubState(new FreeplayState(
          {
            fromResults: freeplay.fromResultsParams
          }, freeplay.stickerSubState));
        freeplay = null;
      }
    }

    curSelectedStorySelect = isStorySelectUnlocked ? 0 : 1;

    storyselectOverlay = new FunkinSprite(0, 0);
    storyselectOverlay.makeGraphic(1280, 720, 0xFF000000);
    storyselectOverlay.alpha = 0.8; //0.8
    storyselectOverlay.screenCenter();
    storyselectOverlay.updateHitbox();
    storyselectOverlay.scrollFactor.set();
    storyselectOverlay.alpha = 0.0;
    add(storyselectOverlay);

    storyselectHeader = new FunkinSprite(0, 0).loadTexture("story-select/story-select-text");
    storyselectHeader.screenCenter();
    storyselectHeader.y = 29;
    storyselectHeader.updateHitbox();
    storyselectHeader.scrollFactor.set();
    storyselectHeader.alpha = 0.0;
    add(storyselectHeader);

    storyselectButtonCustom = new FunkinSprite(0, 0).loadTexture("story-select/storybutt-dokifunk");
    storyselectButtonCustom.screenCenter();
    storyselectButtonCustom.y -= 85;
    storyselectButtonCustom.updateHitbox();
    storyselectButtonCustom.scrollFactor.set();
    storyselectButtonCustom.shader = new FlxRuntimeShader(Assets.getText(Paths.frag('CustomStorySelectButtonShader')));
    storyselectButtonCustom.shader.setFloat("isSelected", (curSelectedStorySelect == 0) ? 1.0 : 0.0);
    storyselectButtonCustom.shader.setFloat("isLocked", hasUnlockAnimationPlayed ? 0.0 : 1.0);
    storyselectButtonCustom.alpha = 0.0;
    add(storyselectButtonCustom);

    storyselectButtonVanilla = new FunkinSprite(0, 0).loadTexture("story-select/storybutt-vanilla");
    storyselectButtonVanilla.screenCenter();
    storyselectButtonVanilla.y += 198;
    storyselectButtonVanilla.updateHitbox();
    storyselectButtonVanilla.scrollFactor.set();
    storyselectButtonVanilla.shader = new FlxRuntimeShader(Assets.getText(Paths.frag('CustomStorySelectButtonShader')));
    storyselectButtonVanilla.shader.setFloat("isSelected", (curSelectedStorySelect == 1) ? 1.0 : 0.0);
    storyselectButtonVanilla.shader.setFloat("isLocked", 0.0);
    storyselectButtonVanilla.alpha = 0.0;
    add(storyselectButtonVanilla);

    storyselectLock = new FlxAtlasSprite(-500, -290, Paths.animateAtlas("story-select/lock-dokifunk"));
    storyselectLock.scale.set(2.4, 2.4);
    storyselectLock.updateHitbox();
    storyselectLock.anim.play('lock-unselect', true);
    storyselectLock.alpha = 0.0;
    add(storyselectLock);

    storyselectLockString = "Complete the vanilla game's\nStory Mode to unlock\n(including WeekEnd 1)";

    storyselectLockText = new BAlphabet(-140, -160, storyselectLockString);
    storyselectLockText.scale.set(0.63, 0.7);
    storyselectLockText.text = "";
    add(storyselectLockText);

    new FlxTimer().start(0.4, function(_) {
      preventEsc = false;
    });

  }

  override function update(elapsed:Float):Void
  {
    super.update(elapsed);

    checker.x += 0.5 * (elapsed / (1 / 120));
    checker.y -= 0.16 / 144;

    if (isPlayingUnlockAnimation)
    {
      playingUnlockAnimationTimer = Math.max(0.0, playingUnlockAnimationTimer - elapsed);
      storyselectButtonCustom.shader.setFloat("isLocked", Math.min(1.0, playingUnlockAnimationTimer / 0.5));
      if (playingUnlockAnimationTimer <= Math.EPSILON) isPlayingUnlockAnimation = false;
    }

    if (FlxG.sound.music != null && FlxG.sound.music.volume < 0.8) FlxG.sound.music.volume += 0.5 * elapsed;

    if (isStorySelectOpen) doControl_StorySelect();
    else doControl();
  }

  function doControl_StorySelect()
  {
    if (confirming)
    {
      return;
    }

    if (controls.UI_UP_P || controls.UI_DOWN_P) changeItem_StorySelect();

    if (controls.BACK)
    {
      confirming = true;
      FunkinSound.playOnce(Paths.sound('cancelMenu'));
      toggleStorySelectMenuVisuals(false);
      new FlxTimer().start(0.4, function(_) {
        confirming = false;
        isStorySelectOpen = false;
      });
      for (i in 0...menuItems.members.length)
      {
        if (i == curSelected) continue;
        FlxTween.tween(menuItems.members[i], {alpha: 1.0}, 0.4,
          {
            ease: FlxEase.quadOut,
            onComplete: function(twn:FlxTween) {
            }
          });
      }
    }

    if (controls.ACCEPT)
    {
      confirming = true;
      FunkinSound.playOnce(Paths.sound('confirmMenu'));
      switch (curSelectedStorySelect)
      {
        case 0:
          storyselectLock.anim.play('lock-anim');
          if (isStorySelectUnlocked)
          {
            hasSelectedCustomStory = true;
            new FlxTimer().start(0.46, function(_) {
              confirming = false;
              FlxG.switchState(new DokiStoryMenuState());
            });
          }
          else
          {
            new FlxTimer().start(0.46, function(_) {
              confirming = false;
            });
          }
        case 1:
          new FlxTimer().start(0.46, function(_) {
            confirming = false;
            FlxG.switchState(new StoryMenuState());
          });
      }
    }
  }

  function doControl()
  {
    if (confirming)
    {
      return;
    }

    if (controls.UI_UP_P) changeItem(-1);

    if (controls.UI_DOWN_P) changeItem(1);

    if (controls.DEBUG_MENU)
    {
      persistentUpdate = false;

      openSubState(new DebugMenuSubState());
    }

    if (controls.BACK && !preventEsc)
    {
      FunkinSound.playOnce(Paths.sound('cancelMenu'));
      FlxG.switchState(new TitleState());
    }

    if (controls.ACCEPT)
    {
      confirming = true;
      FunkinSound.playOnce(Paths.sound('confirmMenu'));
      switch (optionShit[curSelected])
      {
        case 'story':
          new FlxTimer().start(0.4, function(_) {
            confirming = false;
            isStorySelectOpen = true;
            toggleStorySelectMenuVisuals(true);
            if (isStorySelectUnlocked && !hasUnlockAnimationPlayed)
            {
              confirming = true;
              hasUnlockAnimationPlayed = true;
              storyselectLock.anim.play('unlock-anim');
              var animDuration:Float = 64.0 / 24.0;
              isPlayingUnlockAnimation = true;
              playingUnlockAnimationTimer = animDuration;
              new FlxTimer().start(animDuration, function(_) {
                confirming = false;
                storyselectLock.alpha = 0.0;
              });
            }
          });
          for (i in 0...menuItems.members.length)
          {
            if (i == curSelected) continue;
            FlxTween.tween(menuItems.members[i], {alpha: 0}, 0.4,
              {
                ease: FlxEase.quadOut,
                onComplete: function(twn:FlxTween) {
                  
                }
              });
          }
          return;

        case 'freeplay':
          persistentDraw = true;
          persistentUpdate = false;
          FlxTransitionableState.skipNextTransIn = FlxTransitionableState.skipNextTransOut = true;
          new FlxTimer().start(0.4, function(_) {
            confirming = false;
            openSubState(new FreeplayState());
          });
        case 'merch':
          WindowUtil.openURL('https://dokimerch.com/');
          confirming = false;
          // WindowUtil.openURL(Constants.URL_MERCH);
          return; // maybe skip animating here???
        case 'options':
          new FlxTimer().start(0.4, function(_) {
            confirming = false;
            FlxG.switchState(new OptionsState());
          });
        case 'credits':
          new FlxTimer().start(0.4, function(_) {
            confirming = false;
            FlxG.switchState(ScriptedMusicBeatState.init("PsychCredits"));
          });
      }

      for (i in 0...menuItems.members.length)
      {
        if (i == curSelected) continue;
        FlxTween.tween(menuItems.members[i], {alpha: 0}, 0.4,
          {
            ease: FlxEase.quadOut,
            onComplete: function(twn:FlxTween) {
              menuItems.members[i].kill();
            }
          });
      }
    }
  }

  function changeItem_StorySelect()
  {
    FunkinSound.playOnce(Paths.sound('scrollMenu'));
	
    if (curSelectedStorySelect == 0)
    {
      storyselectButtonCustom.shader.setFloat("isSelected", 0.0);
      storyselectButtonVanilla.shader.setFloat("isSelected", 1.0);
      curSelectedStorySelect = 1;
      storyselectLock.anim.play('lock-unselect', true);
    }
    else if (curSelectedStorySelect == 1)
    {
      storyselectButtonCustom.shader.setFloat("isSelected", 1.0);
      storyselectButtonVanilla.shader.setFloat("isSelected", 0.0);
      curSelectedStorySelect = 0;
      storyselectLock.anim.play('lock-selected', true);
    }
	
  }

  function changeItem(huh:Int = 0)
  {
    if (huh != 0) FunkinSound.playOnce(Paths.sound('scrollMenu'));
    menuItems.members[curSelected].animation.play('idle');
    menuItems.members[curSelected].updateHitbox();

    curSelected += huh;

    if (curSelected >= menuItems.length) curSelected = 0;
    if (curSelected < 0) curSelected = menuItems.length - 1;

    menuItems.members[curSelected].animation.play('selected');
    menuItems.members[curSelected].centerOffsets();
  }

  function toggleStorySelectMenuVisuals(huh:Bool)
  {
    var alphaHuh:Float = huh ? 1.0 : 0.0;
    storyselectOverlay.alpha = alphaHuh;
    storyselectHeader.alpha = alphaHuh;
    storyselectButtonCustom.alpha = alphaHuh;
    storyselectButtonVanilla.alpha = alphaHuh;
    storyselectLock.alpha = hasUnlockAnimationPlayed ? 0.0 : alphaHuh;
    storyselectLockText.text = (huh && !isStorySelectUnlocked) ? storyselectLockString : "";
	
    if (huh && !isStorySelectUnlocked)
    {
      storyselectLock.anim.play('lock-unselect', true);
    }
  }

  override function onOpenSubStateComplete(targetState:FlxSubState)
  {
    new FlxTimer().start(0.45, restoreOptions);

    super.onOpenSubStateComplete(targetState);
  }

  function restoreOptions()
  {
    for (i in 0...menuItems.members.length)
    {
      if (i == curSelected) continue;
      menuItems.members[i].revive();
      menuItems.members[i].alpha = 1;
    }
  }
}
