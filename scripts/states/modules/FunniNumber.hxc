import funkin.Paths;
import funkin.graphics.FunkinSprite;
import funkin.modding.base.ScriptedFlxSpriteGroup;
import funkin.FunkinMemory;

class FunniNumber extends ScriptedFlxSpriteGroup
{
  var prevText:String = "";
  var nums = [];

  public function new()
  {
    // FunkinSprite.cacheSparrow("scorenums");
    FunkinMemory.cacheTexture(Paths.image("scorenums"));
    super();
  }

  public function displayText(text:String, isScore:Bool)
  {
    if (text == prevText) return;
    prevText = text;

    // Adds commas
    var textConverted:String = "";
    var commaCounter:Int = 0;
    for (i in 0...text.length)
    {
      var currentChar = text.charAt(text.length - 1 - i);
      commaCounter = commaCounter + 1;
      if (commaCounter >= 4 && currentChar != "-")
      {
        commaCounter = 1;
        textConverted = "," + textConverted;
      }
      textConverted = currentChar + textConverted;
    }

    for (i in 0...textConverted.length)
    {
      if (nums.length <= i) addDigit();
      var prefix = isScore ? "" : "-miss";
      var animName = (textConverted.charAt(i) == "-") ? ("minus") : (textConverted.charAt(i) + prefix);

      nums[i].animation.play(animName, true);
    }
    while (nums.length > textConverted.length)
    {
      var trash = nums.pop();
      remove(trash);
      trash.destroy();
    }
  }

  function addDigit()
  {
    var curLen:Int = nums.length;
    var sprite:FunkinSprite = FunkinSprite.createSparrow(30 * curLen, 0, "scorenums");
    sprite.animation.addByPrefix("minus", "negative", 1, false);
    sprite.animation.addByPrefix("0", "num0-default", 1, false);
    sprite.animation.addByPrefix("1", "num1-default", 1, false);
    sprite.animation.addByPrefix("2", "num2-default", 1, false);
    sprite.animation.addByPrefix("3", "num3-default", 1, false);
    sprite.animation.addByPrefix("4", "num4-default", 1, false);
    sprite.animation.addByPrefix("5", "num5-default", 1, false);
    sprite.animation.addByPrefix("6", "num6-default", 1, false);
    sprite.animation.addByPrefix("7", "num7-default", 1, false);
    sprite.animation.addByPrefix("8", "num8-default", 1, false);
    sprite.animation.addByPrefix("9", "num9-default", 1, false);
    sprite.animation.addByPrefix(",", "comma-default", 1, false);
    sprite.animation.addByPrefix("0-miss", "num0-miss", 1, false);
    sprite.animation.addByPrefix("1-miss", "num1-miss", 1, false);
    sprite.animation.addByPrefix("2-miss", "num2-miss", 1, false);
    sprite.animation.addByPrefix("3-miss", "num3-miss", 1, false);
    sprite.animation.addByPrefix("4-miss", "num4-miss", 1, false);
    sprite.animation.addByPrefix("5-miss", "num5-miss", 1, false);
    sprite.animation.addByPrefix("6-miss", "num6-miss", 1, false);
    sprite.animation.addByPrefix("7-miss", "num7-miss", 1, false);
    sprite.animation.addByPrefix("8-miss", "num8-miss", 1, false);
    sprite.animation.addByPrefix("9-miss", "num9-miss", 1, false);
    sprite.animation.addByPrefix(",-miss", "comma-miss", 1, false);
    nums.push(sprite);
    add(sprite);
    sprite.scale.set(0.6, 0.6);
    sprite.updateHitbox();
  }
}
