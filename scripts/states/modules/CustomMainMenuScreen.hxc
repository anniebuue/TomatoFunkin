import funkin.audio.FunkinSound;
import flixel.util.FlxTimer;
import funkin.play.PauseSubState;
import funkin.play.PlayStatePlaylist;
import flixel.addons.transition.FlxTransitionableState;
import funkin.play.PlayState;
import funkin.ui.freeplay.FreeplayState;
import funkin.modding.module.Module;
import funkin.modding.base.ScriptedMusicBeatState;
import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.transition.stickers.StickerSubState;
import funkin.ui.story.StoryMenuState;
import flixel.FlxG;
import funkin.save.Save;
import funkin.ui.FullScreenScaleMode;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.math.FlxPoint;
import flixel.util.FlxAxes;
import flixel.util.FlxHorizontalAlign;
import flixel.util.FlxVerticalAlign;
import lime.app.Application;
import funkin.util.Constants;
import funkin.util.WindowUtil;

class CustomMainMenuScreen extends Module
{
  var st = null;
  var freePlay:FreeplayState = null;
  var stateMenu:Int = 0;
  var currentWindowWidth:Int = 1280;
  var currentWindowHeight:Int = 720;
  var savedWindowWidth:Int = 1280;
  var savedWindowHeight:Int = 720;
  var maximizedWindowWidth:Int = 0;
  var maximizedWindowHeight:Int = 0;
  var aspectRatio:Float;
  var screenStretched:Bool = false;
  var triggeredResizableTimer:Bool = false;

  // 0 - Outside
  // 1 - In Freeplay
  // 2 - Closing
  // 3 - Rank Anim

  var isStorySelectUnlocked:Bool = false;
  var isPlayingCustomStory:Bool = false;

  function new()
  {
    super("custom-menu-mod");
  }

  override function onCreate(event)
  {
    PauseSubState.PAUSE_MENU_ENTRIES_STANDARD[4].callback = onPlayStateExit;
    Application.current.window.width = currentWindowWidth;
    Application.current.window.height = currentWindowHeight;
    Application.current.window.resizable = false;
    aspectRatio = 16.0 / 9.0;
    FlxG.scaleMode = new FullScreenScaleMode(false);
    FlxG.scaleMode.onMeasureAwait(currentWindowWidth, currentWindowHeight);
    FullScreenScaleMode.maxAspectRatio = FlxPoint.get(16, 9);
    screenStretched = false;
    super.onCreate(event);
  }

  function onPlayStateExit(state:PauseSubState):Void // The action when exiting from a song
  {
    state.allowInput = false;

    PlayState.instance.deathCounter = 0;

    FlxTransitionableState.skipNextTransIn = true;
    FlxTransitionableState.skipNextTransOut = true;

    var targetState = (PlayStatePlaylist.isStoryMode) ? (isPlayingCustomStory ? (sticker) -> new DokiStoryMenuState(sticker) : (sticker) -> new StoryMenuState(sticker)) : (sticker) -> build(sticker);

    if (PlayStatePlaylist.isStoryMode) PlayStatePlaylist.reset();

    state.openSubState(new StickerSubState({targetState: targetState}));
  }

  function build(sticker:StickerSubState)
  {
    st = ScriptedMusicBeatState.init("CustomMainMenu");
    if (freePlay != null) freePlay.stickerSubState = sticker;
    st.scriptSet("freeplay", (freePlay != null) ? freePlay : new FreeplayState(null, sticker));
    stateMenu = 3;

    isStorySelectUnlocked = verifyCustomUnlockCondition();
    st.scriptSet("isStorySelectUnlocked", isStorySelectUnlocked);

    isPlayingCustomStory = false;

    st.persistentUpdate = false;
    st.persistentDraw = true;
    return st;
  }

  override function onStateChangeEnd(event)
  {
    if (Std.isOfType(event.targetState, MainMenuState))
    {
      FlxG.switchState(() -> {
        trace("FREEPLAY: ");
        trace(freePlay);
        st = ScriptedMusicBeatState.init("CustomMainMenu");
        st.scriptSet("freeplay", freePlay);
        if (freePlay != null && freePlay.prepForNewRank) stateMenu = 3;

        isStorySelectUnlocked = verifyCustomUnlockCondition();
        st.scriptSet("isStorySelectUnlocked", isStorySelectUnlocked);

        isPlayingCustomStory = false;

        return st; // 3
      });
    }

    if (Std.isOfType(event.targetState, StoryMenuState) && isPlayingCustomStory)
    {
      FlxG.switchState(new DokiStoryMenuState());
    }

    super.onStateChangeEnd(event);
  }

  override function onSubStateOpenEnd(event)
  {
    if (Std.isOfType(event.targetState, FreeplayState)) freePlay = event.targetState;
    super.onSubStateOpenEnd(event);
  }

  //* This replaces freeplay's closing routine
  override function onUpdate(event)
  {
    super.onUpdate(event);

    if (!triggeredResizableTimer)
    {
      triggeredResizableTimer = true;
      new FlxTimer().start(0.8, (_) -> {
        Application.current.window.resizable = true;
      });
    }

    if (Application.current.window.fullscreen || (Application.current.window.maximized && (!screenStretched || (Application.current.window.width == maximizedWindowWidth && Application.current.window.height == maximizedWindowHeight))))
    {
      if (!screenStretched)
      {
        screenStretched = true;
        savedWindowWidth = currentWindowWidth;
        savedWindowHeight = currentWindowHeight;
        maximizedWindowWidth = Application.current.window.width;
        maximizedWindowHeight = Application.current.window.height;
      }
      currentWindowWidth = Application.current.window.width;
      currentWindowHeight = Application.current.window.height;
      var currentAspectRatio:Float = Std.parseFloat(Std.string(currentWindowWidth)) / Std.parseFloat(Std.string(currentWindowHeight));
      var offsetRenderX:Int = 0;
      var offsetRenderY:Int = 0;
      if (currentAspectRatio > aspectRatio)
      {
        offsetRenderX = (currentWindowWidth - currentWindowHeight * aspectRatio) / 2;
        currentWindowWidth = currentWindowHeight * aspectRatio;
      }
      else
      {
        offsetRenderY = (currentWindowHeight - currentWindowWidth / aspectRatio) / 2;
        currentWindowHeight = currentWindowWidth / aspectRatio;
      }
      FlxG.scaleMode.horizontalAlign = FlxHorizontalAlign.CENTER;
      FlxG.scaleMode.verticalAlign = FlxVerticalAlign.CENTER;
      FlxG.scaleMode.onMeasureInstant(currentWindowWidth, currentWindowHeight);
	  FlxG.scaleMode.offset.x = offsetRenderX;
	  FlxG.scaleMode.offset.y = offsetRenderY;
      FullScreenScaleMode.cutoutSize.set(offsetRenderX, offsetRenderY);
      FullScreenScaleMode.gameCutoutSize.set(offsetRenderX, offsetRenderY);
      FlxG.scaleMode.updateGamePosition();
    }
    else if (screenStretched)
    {
      screenStretched = false;
      currentWindowWidth = savedWindowWidth;
      currentWindowHeight = savedWindowHeight;
      Application.current.window.width = currentWindowWidth;
      Application.current.window.height = currentWindowHeight;
      Application.current.window.fullscreen = false;
      Application.current.window.maximized = false;
    }

    if (!screenStretched && (Application.current.window.width != currentWindowWidth || Application.current.window.height != currentWindowHeight))
    {
      if (Application.current.window.width > Application.current.window.height)
      {
        currentWindowWidth = Application.current.window.width;
        currentWindowHeight = currentWindowWidth / aspectRatio;
      }
      else
      {
        currentWindowHeight = Application.current.window.height;
        currentWindowWidth = Application.current.window.height * aspectRatio;
      }
      Application.current.window.width = currentWindowWidth;
      Application.current.window.height = currentWindowHeight;
      FlxG.scaleMode.onMeasureAwait(currentWindowWidth, currentWindowHeight);
    }

    if (!isPlayingCustomStory && st != null && st.scriptGet("hasSelectedCustomStory") == true) isPlayingCustomStory = true;

    if (freePlay == null || !freePlay.active) return;

    if (freePlay.subState != null)
    {
      freePlay.backingCard.cardGlow.visible = false;
      return;
    }
    var observer_value = freePlay.backingCard.cardGlow.visible; // freePlay.backingCard.funnyScroll.visible

    if (stateMenu == 1 && observer_value)
    {
      // `prevOpange` got shown AND hidden
      trace("We are closing freeplay now");
      FlxTimer.globalManager.clear();
      FlxG.state.persistentDraw = true;

      stateMenu = 2;
      freePlay.backingCard.cardGlow.visible = false;
      trace("Closing");
      new FlxTimer().start(0.4, (_) -> {
        FlxTransitionableState.skipNextTransIn = true;
        FlxTransitionableState.skipNextTransOut = true;
        FunkinSound.playMusic('freakyMenu',
          {
            overrideExisting: true,
            restartTrack: true,
            persist: true
          });
        // FlxG.sound.music.fadeIn(4.0, 0.0, 1.0);
        freePlay.close();
        freePlay.alive = false;
        stateMenu = 0;
      });
    }
    else if (stateMenu != 1 && observer_value)
    {
      // We are done initing
      trace("Done initting");
      stateMenu = 1;
      freePlay.backingCard.cardGlow.visible = false;
    }
  }
  
  function verifyCustomUnlockCondition()
  {
    var requiredWeeks:Array<String> = ['tutorial', 'week1', 'week2', 'week3', 'week4', 'week5', 'week6', 'week7', 'weekend1'];
    for (i in 0...requiredWeeks.length)
    {
      if (!customHasBeatenLevel(requiredWeeks[i], ['normal', 'hard']))
      {
        return false;
      }
    }
	return true;
  }

  function customHasBeatenLevel(levelId:String, ?difficultyList:Array<String>):Bool
  {
    if (difficultyList == null)
    {
      difficultyList = ['easy', 'normal', 'hard'];
    }
    for (difficulty in difficultyList)
    {
      var score:Null<SaveScoreData> = Save.instance.getLevelScore(levelId, difficulty);
      if (score != null)
      {
        if (score.score > 0)
        {
          return true;
        }
        else
        {
          continue;
        }
      }
    }
    return false;
  }
}
